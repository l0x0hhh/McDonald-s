# 本机凭据只在后端保存；网页设置页可保存/替换两个 Key，不回显。
# backend/data/settings.local.json 为设置页的本地覆盖文件，已被 .gitignore 排除。
# 已保存的本地 Key 优先于对应环境变量；空白提交保留现有值。

# 麦当劳 MCP 接入：地址由服务端部署配置，网页不接受 URL。
MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=
MCD_MCP_CONTEXT=

# DeepSeek 为唯一生产模型来源，模型固定 deepseek-flash，思考模式关闭。
# 仅使用 DEEPSEEK_API_KEY 或设置页保存的 Key，不读取 OpenAI Key 或订阅。
DEEPSEEK_API_KEY=

DATA_MODE=live
DEFAULT_STORE_CODE=1400011
DEFAULT_CITY=广州
DEFAULT_STORE_KEYWORD=天河区体育西路
MCP_TIMEOUT=25
