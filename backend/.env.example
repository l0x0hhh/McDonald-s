# 复制为 backend/.env 并填入真实值。.env 已被 .gitignore 排除，
# 任何 Token / API Key 不得提交到仓库。

# 麦当劳 MCP 接入：地址与 Token 以 open.mcd.cn/mcp 平台实际提供为准。
# 注意：MCP 工具返回的低价中含「随单购麦金卡优惠」类，需同单购卡才成立，
# 适配层会把这些商品标记 requires_membership，算法层不得直接按低价求和。
MCD_MCP_URL=
MCD_MCP_TOKEN=

# 可选：部分 MCP 网关需要额外的上下文头，平台没提供就留空
MCD_MCP_CONTEXT=

# 运行模式：live 只走真实 MCP；demo 只走本地快照；auto 优先真实、失败降级快照
DATA_MODE=auto

# 默认门店（广州天河今日广场）与到店自取参数
DEFAULT_STORE_CODE=1400011
DEFAULT_CITY=广州
DEFAULT_STORE_KEYWORD=天河区体育西路

# MCP 超时（秒）
MCP_TIMEOUT=25
